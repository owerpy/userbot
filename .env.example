# Telegram API (получить на https://my.telegram.org → API development tools)
TG_APP_ID=123456
TG_APP_HASH=your_api_hash
TG_PHONE=+998901234567          # номер аккаунта-подписчика (твой)
# TG_2FA=your_2fa_password      # если на аккаунте включён облачный пароль

# База Truck Delivery (та же, где board_ads / board_channels)
DATABASE_URL=postgres://user:pass@host:5432/truck_delivery?sslmode=disable

# Groq
GROQ_API_KEY=gsk_...
# Модель (бесплатный тариф Groq, суточные лимиты токенов):
#   openai/gpt-oss-120b     — РЕКОМЕНДУЕТСЯ: 200k/сутки, разбирает точно
#   llama-3.3-70b-versatile — 100k/сутки, точная, но квота кончается быстро
#   llama-3.1-8b-instant    — большая квота, но путает поля (цена/количество)
GROQ_MODEL=openai/gpt-oss-120b

TG_SESSION_DIR=/data/session

# Первичная загрузка истории при старте (чтобы доска не была пустой).
# BOARD_BACKFILL=0 — выключить. BOARD_BACKFILL_LIMIT — сколько последних постов читать.
BOARD_BACKFILL=1
BOARD_BACKFILL_LIMIT=30

# Пакетная обработка: объявления уходят в ИИ пачками — системный промпт
# оплачивается один раз на всю пачку (экономия токенов примерно втрое).
BOARD_BATCH_SIZE=10          # сколько объявлений в одном запросе
BOARD_BATCH_WAIT_SEC=20      # сколько ждать наполнения пачки
BOARD_BATCH_PAUSE_SEC=10     # пауза между пачками (минутный лимит токенов)
